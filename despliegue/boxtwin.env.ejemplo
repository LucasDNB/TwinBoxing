# BoxTwin - Entorno de los dos servicios.
#
#   sudo install -m 600 -o lucasb -g lucasb boxtwin.env.ejemplo /etc/boxtwin.env
#   sudo -u lucasb editor /etc/boxtwin.env
#
# Modo 600: adentro van el secreto de sesion y el codigo de invitacion.
# systemd NO expande variables ni corre un shell sobre este archivo: cada valor va literal,
# sin comillas y sin $OTRA_VARIABLE.

# -- lo que hay que cambiar si o si -----------------------------------------

# Sin esto el servidor genera un secreto al arrancar y todas las sesiones abiertas se caen
# en cada reinicio. Generarlo con: openssl rand -hex 32
BOXTWIN_SECRETO=CAMBIAME

# Quien se puede crear una cuenta. Sin esta variable el registro queda CERRADO, que es el
# default a proposito: una instancia abierta detras de un tunel es una GPU ajena gratis
# para cualquiera que tenga la URL. Poner un codigo y darselo a los que van a probar.
BOXTWIN_INVITACION=CAMBIAME

# -- datos ------------------------------------------------------------------

# Aca se acumulan los videos y todo lo que produce cada sesion. Un video de 30 minutos son
# unos 3 GB y no se borra solo: mirar el disco cada tanto.
BOXTWIN_DATOS=/home/lucasb/boxtwin/datos

# sqlite alcanza mientras haya UN worker, que es el caso: la exclusion de la cola sale de
# un UPDATE condicional y esta testeada. El dia que haya dos workers, o que la API y el
# worker vivan en maquinas distintas, hay que pasar a PostgreSQL y es esta linea:
#   BOXTWIN_DB=postgresql+psycopg://boxtwin:CLAVE@localhost/boxtwin
# El Cap 4 declara PostgreSQL, asi que si las sesiones de prueba corren sobre sqlite, eso
# es lo que hay que escribir en la tesis.
BOXTWIN_DB=sqlite:////home/lucasb/boxtwin/datos/boxtwin.db

# El frontend construido (npm run build). Servirlo desde la misma API deja un solo origen,
# que es lo que hace que alcance con exponer un puerto.
BOXTWIN_WEB=/home/lucasb/Proyectos/TwinBoxing/boxtwin-web/dist

# -- modelos ----------------------------------------------------------------
# Rutas absolutas. El directorio de trabajo de un servicio no es el que uno cree.

BOXTWIN_MODELO_POSE=/home/lucasb/Proyectos/TwinBoxing/yolov8l-pose.pt
BOXTWIN_MODELO_GUANTES=/home/lucasb/Proyectos/TwinBoxing/boxtwin-guantes/modelos/guantes-v2.pt
BOXTWIN_MODELO_DETECTOR=/home/lucasb/Proyectos/TwinBoxing/modelos/detector_7fuentes.ens.pt
BOXTWIN_CMD=/home/lucasb/miniforge3/envs/twinboxing_env/bin/boxtwin-annotator
BOXTWIN_DEVICE=0
BOXTWIN_UMBRAL=0.80

# -- clasificacion del tipo de golpe (opcional) ------------------------------
# Sin esto el tipo queda sin estimar y el resto de la Fight-Card no depende de el. Corre en
# el otro entorno conda, que no se mezcla con este.
#BOXTWIN_CMD_CLASIFICADOR=/home/lucasb/miniforge3/envs/boxtwin_mmaction/bin/python /home/lucasb/Proyectos/TwinBoxing/boxtwin-detector/tools/clasificar_sesion.py
#BOXTWIN_CONFIG_CLASIFICADOR=/home/lucasb/Proyectos/TwinBoxing/modelos/poseC3D_7fuentes.py
#BOXTWIN_CHECKPOINT_CLASIFICADOR=/home/lucasb/Proyectos/TwinBoxing/modelos/poseC3D_7fuentes.pth
