# BoxTwin - La imagen del worker.
#
# UN SOLO ENTORNO, SIN OPENMMLAB (decision de Lucas, 20-10-2026)
#   La estacion clasifica el tipo de golpe con el modelo geometrico (tipo v2,
#   BOXTWIN_CLASIFICADOR=geometrico), que corre en el mismo entorno que la pose y el
#   detector: torch y numpy. El segundo entorno, con mmcv compilado contra CUDA 11.8, solo
#   hacia falta para PoseConv3D, y era donde se iban los dias de build. PoseConv3D sigue
#   disponible por fuera del contenedor, con el entorno conda local y
#   BOXTWIN_CMD_CLASIFICADOR + BOXTWIN_CLASIFICADOR=poseconv3d.
#
# LAS VERSIONES SON LAS DE LA ESTACION (20-10): python 3.12, torch 2.6.0+cu124, torchvision
#   0.21.0, ultralytics 8.4.41, opencv 4.13.0, numpy 2.4.3. El worker medido corre con eso;
#   otra version es otro sistema.
#
# NO HACE FALTA LA IMAGEN devel: no se compila nada. Las ruedas de torch traen su runtime
#   de CUDA y el driver lo pone el NVIDIA Container Toolkit del host.

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/conda/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget git ffmpeg libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO /tmp/mf.sh https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
    && bash /tmp/mf.sh -b -p /opt/conda && rm /tmp/mf.sh

# -- entorno 1: pose, identidad y detector -----------------------------------
RUN conda create -y -n twinboxing_env python=3.12 && conda clean -afy
RUN /opt/conda/envs/twinboxing_env/bin/pip install --no-cache-dir \
        torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124 \
    && /opt/conda/envs/twinboxing_env/bin/pip install --no-cache-dir \
        ultralytics==8.4.41 "opencv-python-headless==4.13.*" numpy==2.4.3 \
        "pydantic>=2.6" pyyaml lap==0.5.13

WORKDIR /app
COPY boxtwin-annotator /app/boxtwin-annotator
COPY boxtwin-detector /app/boxtwin-detector
COPY boxtwin-api /app/boxtwin-api

RUN /opt/conda/envs/twinboxing_env/bin/pip install --no-cache-dir \
        -e /app/boxtwin-annotator -e /app/boxtwin-detector -e "/app/boxtwin-api[postgres]"

# Los pesos NO van adentro de la imagen: se montan. Un checkpoint nuevo no puede pedir
# rehacer la imagen, y menos un engine de TensorRT, que no se copia entre maquinas (RNF2).
# Los nombres son los de la estacion; /modelos se arma como dice despliegue/README.md.
ENV BOXTWIN_CMD="/opt/conda/envs/twinboxing_env/bin/boxtwin-annotator" \
    BOXTWIN_DATOS=/datos \
    BOXTWIN_CLASIFICADOR=geometrico \
    BOXTWIN_MODELO_POSE=/modelos/yolov8l-pose.pt \
    BOXTWIN_MODELO_GUANTES=/modelos/guantes-v2.pt \
    BOXTWIN_MODELO_DETECTOR=/modelos/detector_7fuentes.ens.pt \
    BOXTWIN_MODELO_CLASIFICADOR_GEO=/modelos/clasificador_geo_v1 \
    BOXTWIN_MODELO_CLASIFICADOR_GEO_INDIVIDUAL=/modelos/clasificador_geo_v1_sin_rival

VOLUME ["/datos", "/modelos"]
CMD ["/opt/conda/envs/twinboxing_env/bin/python", "-m", "boxtwin_api.worker"]
