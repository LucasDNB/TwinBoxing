{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxtwin/contrato/fightcard-0.3.schema.json",
  "title": "Fight-Card de BoxTwin, 0.1 a 0.3",
  "description": "Contrato entre el worker (boxtwin.mvp.fightcard.construir) y la web entrenador (lib/api/esquemas.ts). 0.2 es compatible hacia atras con 0.1 (prototipo/specs/05-api-y-datos.md §4) y 0.3 con 0.2 (prototipo/specs/ampliacion-13-10). Cambios en CHANGELOG.md. Golpes DETECTADOS: el documento no puede traer conectados, puntuacion ni veredicto (RF6, RF8).",
  "type": "object",
  "required": ["version", "video", "identidad", "detector", "clasificador", "peleadores", "nomenclatura", "no_incluye"],
  "properties": {
    "version": { "enum": ["0.1", "0.2", "0.3"] },
    "video": {
      "type": "object",
      "required": ["duracion_s", "fps", "rounds"],
      "properties": {
        "nombre": { "type": ["string", "null"] },
        "duracion_s": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "inicio_s", "fin_s"],
            "properties": {
              "round": { "type": "integer", "minimum": 1 },
              "inicio_s": { "type": "number" },
              "fin_s": { "type": "number" }
            }
          }
        }
      }
    },
    "identidad": {
      "type": "object",
      "properties": {
        "cobertura_A": { "type": "number", "minimum": 0, "maximum": 1 },
        "cobertura_B": { "type": "number", "minimum": 0, "maximum": 1 },
        "sin_asignar": { "type": "number", "minimum": 0, "maximum": 1 },
        "tramos_total": { "type": ["integer", "null"], "minimum": 0 },
        "tramos_asignados_auto": { "type": ["integer", "null"], "minimum": 0 },
        "tramos_asignados_manual": { "type": ["integer", "null"], "minimum": 0 },
        "separacion_color": { "type": ["number", "null"] }
      }
    },
    "detector": {
      "type": "object",
      "required": ["checkpoint", "precision_medida", "recall_medido"],
      "properties": {
        "checkpoint": { "type": "string" },
        "precision_medida": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall_medido": { "type": "number", "minimum": 0, "maximum": 1 },
        "medido_en": { "enum": ["bolsa", "sombra", "sparring", "combate"] }
      }
    },
    "clasificador": {
      "type": "object",
      "required": ["checkpoint", "exactitud_familia_fuente_no_vista"],
      "properties": {
        "checkpoint": { "type": ["string", "null"] },
        "exactitud_familia_fuente_no_vista": { "type": ["number", "null"] },
        "estimado": { "const": true }
      }
    },
    "peleadores": {
      "type": "object",
      "required": ["A"],
      "properties": {
        "A": { "$ref": "#/$defs/peleador" },
        "B": { "$ref": "#/$defs/peleador" }
      },
      "additionalProperties": false
    },
    "nomenclatura": { "type": "object", "additionalProperties": { "type": "string" } },
    "no_incluye": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "metodos": {
      "description": "0.3: lo escribe la etapa enriquecer (B11) junto con los campos de objetivo de cada golpe; construir no los conoce",
      "type": "object",
      "properties": {
        "objetivo": {
          "type": "object",
          "required": ["regla", "tau", "medido"],
          "properties": {
            "regla": { "type": "string" },
            "tau": { "type": "number" },
            "medido": {
              "type": ["object", "null"],
              "properties": {
                "exactitud_balanceada": { "type": "number" },
                "recall_cuerpo": { "type": "number" },
                "pasa": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["conectados"] },
      { "required": ["puntuacion"] },
      { "required": ["veredicto"] },
      { "required": ["ganador"] }
    ]
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "enum": ["0.2", "0.3"] } } },
      "then": {
        "properties": {
          "identidad": { "required": ["tramos_total", "tramos_asignados_auto", "tramos_asignados_manual", "separacion_color"] },
          "peleadores": {
            "properties": {
              "A": { "$ref": "#/$defs/peleador_02" },
              "B": { "$ref": "#/$defs/peleador_02" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": "0.3" } } },
      "then": {
        "properties": {
          "peleadores": {
            "properties": {
              "A": { "$ref": "#/$defs/peleador_03" },
              "B": { "$ref": "#/$defs/peleador_03" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "conteo": {
      "type": "object",
      "required": ["total", "izq", "der"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "izq": { "type": "integer", "minimum": 0 },
        "der": { "type": "integer", "minimum": 0 },
        "cabeza": { "type": "integer", "minimum": 0 },
        "cuerpo": { "type": "integer", "minimum": 0 },
        "objetivo_sin_dato": { "type": "integer", "minimum": 0 }
      }
    },
    "golpe": {
      "type": "object",
      "required": ["id", "t_inicio", "t_fin", "brazo", "tipo", "confianza_tipo", "corregido"],
      "properties": {
        "id": { "type": "string" },
        "t_inicio": { "type": "number", "minimum": 0 },
        "t_fin": { "type": "number", "minimum": 0 },
        "brazo": { "enum": ["izq", "der"] },
        "tipo": { "type": ["string", "null"] },
        "confianza_tipo": { "type": ["number", "null"] },
        "corregido": {
          "type": ["object", "null"],
          "required": ["tipo"],
          "properties": { "tipo": { "enum": ["jab", "cross", "hook", "uppercut", "no_golpe"] } }
        },
        "descartado": { "type": "boolean" },
        "objetivo": { "enum": ["cabeza", "cuerpo", null] },
        "objetivo_confianza": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "objetivo_motivo": { "enum": ["sin_rival", "sin_pose", "individual", null] }
      }
    },
    "peleador": {
      "type": "object",
      "required": ["golpes", "por_round", "total"],
      "properties": {
        "golpes": { "type": "array", "items": { "$ref": "#/$defs/golpe" } },
        "por_round": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "inicio_s", "fin_s", "total", "izq", "der", "por_minuto"]
          }
        },
        "total": { "$ref": "#/$defs/conteo" },
        "guardia": { "type": "array" },
        "descartados": { "type": "integer", "minimum": 0 }
      }
    },
    "peleador_02": {
      "type": "object",
      "required": ["descartados"],
      "properties": {
        "golpes": { "type": "array", "items": { "type": "object", "required": ["descartado"] } }
      }
    },
    "peleador_03": {
      "type": "object",
      "required": ["combinaciones"],
      "properties": {
        "combinaciones": { "$ref": "#/$defs/combinaciones" }
      }
    },
    "combinaciones": {
      "type": "object",
      "required": ["patron", "separacion", "max_s", "lista", "total", "por_round"],
      "properties": {
        "patron": { "const": "izq-der-izq" },
        "separacion": { "enum": ["inicio_a_inicio", "fin_a_inicio"] },
        "max_s": { "type": "number", "exclusiveMinimum": 0 },
        "lista": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["golpes", "t_inicio", "t_fin", "tipos", "round"],
            "properties": {
              "golpes": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
              "t_inicio": { "type": "number", "minimum": 0 },
              "t_fin": { "type": "number", "minimum": 0 },
              "tipos": { "type": "array", "items": { "type": ["string", "null"] }, "minItems": 3, "maxItems": 3 },
              "round": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "total": { "type": "integer", "minimum": 0 },
        "por_round": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "total"],
            "properties": { "round": { "type": "integer", "minimum": 1 }, "total": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    }
  }
}
